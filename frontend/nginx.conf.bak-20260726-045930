map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

server {
    listen 3000;
    server_name localhost;

    add_header X-ToolHub-Host "ubuntu-purva" always;

    root /usr/share/nginx/html;
    index index.html;

    # Serve crawler-readable, article-specific Open Graph metadata while the
    # same React application renders the page for human readers.
    location = /blogs/raspberry-pi-5-personal-cloud {
        try_files /blog-raspberry-pi-5-personal-cloud.html =404;
    }

    location = /blogs/how-i-put-my-homelab-on-the-internet {
        try_files /blog-how-i-put-my-homelab-on-the-internet.html =404;
    }

    location / {
        try_files $uri /index.html;
    }

    location = /api/v2/admin/system-metrics/stream {
        proxy_pass http://backend:8080/v2/admin/system-metrics/stream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no;
        add_header Cache-Control "no-cache, no-transform";
    }

    location /api/ {
        proxy_pass http://backend:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /api/v2/speedtest/ {
        proxy_pass http://backend:8080/v2/speedtest/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        client_max_body_size 20m;
        proxy_request_buffering off;
        proxy_buffering off;
        gzip off;
    }

    location = /_admin_proxy_auth {
        internal;
        proxy_pass http://backend:8080/v2/admin/proxy/authorize;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    location ^~ /admin-proxy/route-analytics/ {
        auth_request /_admin_proxy_auth;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10m;
        proxy_send_timeout 10m;
        proxy_buffering off;
        proxy_pass http://100.99.75.123:3300;
    }

    location ^~ /admin-proxy/filemanager/ {
        set $admin_prefix /admin-proxy/filemanager;
        proxy_pass http://100.99.75.123:3088/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
    }

    location ^~ /admin-proxy/docker-manager/ {
        set $admin_prefix /admin-proxy/docker-manager;
        proxy_pass http://100.99.75.123:3004/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
    }

    location ^~ /admin-proxy/docker-manager-ubuntu/ {
        set $admin_prefix /admin-proxy/docker-manager-ubuntu;
        proxy_pass http://host.docker.internal:3004/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
    }

    location ^~ /admin-proxy/ai-toolhub/ {
        set $admin_prefix /admin-proxy/ai-toolhub;
        proxy_pass http://100.99.75.123:3005/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
    }

    location ^~ /admin-proxy/ai-toolhub-api/ {
        set $admin_prefix /admin-proxy/ai-toolhub-api;
        proxy_pass http://100.99.75.123:3006/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
    }

    location ^~ /admin-proxy/jellyfin-control/ {
        set $admin_prefix /admin-proxy/jellyfin-control;
        proxy_pass http://host.docker.internal:5050/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
        include /etc/nginx/snippets/admin-proxy-legacy-rewrite.conf;
    }

    location ^~ /admin-proxy/media/radarr/ {
        set $admin_prefix /admin-proxy/media/radarr;
        proxy_pass http://host.docker.internal:7878;
        include /etc/nginx/snippets/admin-proxy-common.conf;
        proxy_redirect off;
        proxy_cookie_path off;
    }

    location ^~ /admin-proxy/media/sonarr/ {
        set $admin_prefix /admin-proxy/media/sonarr;
        proxy_pass http://host.docker.internal:8989;
        include /etc/nginx/snippets/admin-proxy-common.conf;
        proxy_redirect off;
        proxy_cookie_path off;
    }

    location ^~ /admin-proxy/media/prowlarr/ {
        set $admin_prefix /admin-proxy/media/prowlarr;
        proxy_pass http://host.docker.internal:9696;
        include /etc/nginx/snippets/admin-proxy-common.conf;
        proxy_redirect off;
        proxy_cookie_path off;
    }

    location ^~ /admin-proxy/media/qbittorrent/ {
        set $admin_prefix /admin-proxy/media/qbittorrent;
        proxy_pass http://host.docker.internal:8085/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
    }

    location ^~ /admin-proxy/movie-monitor/ {
        return 404;
    }

    location ^~ /admin-proxy/container-logs/ {
        set $admin_prefix /admin-proxy/container-logs;
        proxy_pass http://100.99.75.123:9999/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
    }

    location ^~ /admin-proxy/system-metrics/ {
        set $admin_prefix /admin-proxy/system-metrics;
        proxy_pass http://host.docker.internal:19999/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
    }

    location ^~ /admin-proxy/file-browser/ {
        set $admin_prefix /admin-proxy/file-browser;
        proxy_pass http://100.99.75.123:8088/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
        include /etc/nginx/snippets/admin-proxy-legacy-rewrite.conf;
    }

    location ^~ /admin-proxy/it-tools/ {
        set $admin_prefix /admin-proxy/it-tools;
        proxy_pass http://100.99.75.123:9998/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
        include /etc/nginx/snippets/admin-proxy-legacy-rewrite.conf;
    }

    location ^~ /admin-proxy/beszel/ {
        set $admin_prefix /admin-proxy/beszel;
        proxy_pass http://100.99.75.123:8090/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
        proxy_redirect off;
        proxy_cookie_path off;
    }

    location ^~ /admin-proxy/wavelength/ {
        set $admin_prefix /admin-proxy/wavelength;
        proxy_pass http://100.99.75.123:8083/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
        include /etc/nginx/snippets/admin-proxy-legacy-rewrite.conf;
    }

    location ^~ /admin-proxy/this-day/ {
        set $admin_prefix /admin-proxy/this-day;
        proxy_pass http://100.99.75.123:3001/;
        include /etc/nginx/snippets/admin-proxy-common.conf;
        include /etc/nginx/snippets/admin-proxy-legacy-rewrite.conf;
    }

    # Optional: serve static assets with caching
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot|otf|json)$ {
        expires 1y;
        access_log off;
        add_header Cache-Control "public";
    }
}
